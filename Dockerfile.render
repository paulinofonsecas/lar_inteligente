# Build completo do backend do Lar Inteligente para qualquer host Docker
# (Render, Fly.io, ...). O Dockerfile oficial (packages/home_backend/Dockerfile)
# espera o contexto `dart_frog build`, então aqui o build acontece dentro do
# próprio container: vendors os pacotes path, gera o build/ e compila AOT.
FROM dart:3.12.2 AS build

# dart_frog build precisa da CLI no PATH.
RUN dart pub global activate dart_frog_cli
ENV PATH="/root/.pub-cache/bin:${PATH}"

WORKDIR /src

# Os pacotes path do backend (pubspec: home_catalog, home_timeline).
COPY packages/home_catalog /src/packages/home_catalog
COPY packages/home_timeline /src/packages/home_timeline
COPY packages/home_backend /src/packages/home_backend

WORKDIR /src/packages/home_backend
RUN dart pub get
# Vendoriza as path deps e copia assets/ para build/.
RUN dart_frog build
# O binário AOT não resolve assets de pacote: o deploy copia o prompt do
# catálogo e as regras do feed para build/assets/ (como o deploy.yaml faz).
RUN cp /src/packages/home_catalog/lib/src/prompt/catalog-prompt.prompt \
  build/assets/catalog-prompt.prompt
RUN cp /src/packages/home_timeline/lib/src/feed_rules.json \
  build/assets/feed_rules.json

WORKDIR /src/packages/home_backend/build
RUN dart pub get
RUN dart compile exe bin/server.dart -o bin/server

# Runtime: o binário AOT é standalone; só precisa de glibc e dos certificados
# raiz para chamar o Gemini por HTTPS.
FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/packages/home_backend/build/bin/server /app/bin/server
# Os dotprompt assets são lidos por caminho relativo ao diretório de trabalho.
COPY --from=build /src/packages/home_backend/build/assets /app/assets
# O mundo mockado é lido de data/ na inicialização.
COPY --from=build /src/packages/home_backend/data /app/data

WORKDIR /app
# O host injeta PORT; o Dart Frog o lê.
CMD ["/app/bin/server"]
